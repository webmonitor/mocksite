# Copy to .env and fill in. `.env` is gitignored.
#
# Admin token: at least 32 non-whitespace characters. The process refuses to
# start otherwise. Generate one with: openssl rand -hex 32
MOCKSITE_TOKEN=

# Origin a monitoring platform should collect from (container DNS name).
# Container DNS name of this service (compose service name, not the project name).
MOCKSITE_COLLECT_ORIGIN=http://site:9000

# Origin a developer's browser can open.
MOCKSITE_PUBLIC_ORIGIN=http://127.0.0.1:9000

# critical | error | warning | info | debug | trace
MOCKSITE_LOG_LEVEL=info
